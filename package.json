{
  "name": "deskpal",
  "version": "0.1.0",
  "description": "A drop-in, 90s-style animated desk assistant that answers questions from your docs.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/deskpal.mjs",
  "module": "./dist/deskpal.mjs",
  "exports": {
    ".": "./dist/deskpal.mjs",
    "./iife": "./dist/deskpal.js",
    "./proxy": "./proxy/node/deskpal-proxy.mjs"
  },
  "bin": {
    "deskpal": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "skins",
    "proxy/node",
    "proxy/python/deskpal_proxy.py",
    "proxy/python/requirements.txt",
    "proxy/php",
    "proxy/README.md"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "skin": "node skins/default/generate.mjs && node skins/pencil/generate.mjs",
    "build": "npm run skin && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "spike": "npm run build && node dist/cli.mjs build-index demo/docs -o demo/deskpal-index.json --base-url /docs/ --md-ext \"\" && node scripts/build-spike.mjs && node scripts/serve.mjs",
    "spike:vectors": "node scripts/spike-vectors.ts",
    "demo": "npm run build && node dist/cli.mjs build-index demo/docs -o demo/deskpal-index.json --base-url /docs/ --md-ext \"\" && node scripts/serve.mjs",
    "test:proxy": "node scripts/test-proxy.mjs",
    "test:browser": "npm run build && node --test \"test/e2e/*.e2e.ts\""
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "21.0.4",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "happy-dom": "21.0.4",
    "playwright": "1.64.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1"
  }
}
